# Vercel environment variables for burn site

# WalletConnect (get from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Railway API URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-api.railway.app

# Server-side: proxying admin calls to Railway
API_URL=https://your-api.railway.app
ADMIN_API_KEY=your-secret-key-here

# Comma-separated admin wallet addresses (client-side UI gate)
NEXT_PUBLIC_ADMIN_WALLETS=0xYourWallet1,0xYourWallet2
