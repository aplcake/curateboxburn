# Railway environment variables
PORT=4000
ADMIN_API_KEY=your-secret-key-here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
BASE_RPC_URL=https://mainnet.base.org
BURN_SITE_URL=https://your-burn-site.vercel.app
REVEAL_SITE_URL=https://your-reveal-site.vercel.app
# Optional: custom SQLite path (Railway volume mount)
# DB_PATH=/data/burns.db

# ── Manifold auto-mint (add once contract is ready) ──────────────────────────
# MANIFOLD_CONTRACT_ADDRESS=0xYourManifoldContractAddress
# MANIFOLD_CONTRACT_CHAIN=base        # 'base' or 'mainnet'
# MINTER_PRIVATE_KEY=0xYourMinterWalletPrivateKey
# MANIFOLD_RPC_URL=                   # optional, leave blank to use default

# ── NFT slideshow (paste OpenSea links in admin panel) ───────────────────────
# OPENSEA_API_KEY=                    # get one free at docs.opensea.io — without it requests are heavily rate-limited
