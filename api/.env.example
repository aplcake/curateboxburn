# Railway environment variables
PORT=4000
ADMIN_API_KEY=your-secret-key-here
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
BASE_RPC_URL=https://mainnet.base.org
# ERC-1155 token ID users are sending. The current handover value is 3.
# If the collection/explorer shows a different ID (for example #6), set this
# exact value and set NEXT_PUBLIC_BURN_TOKEN_ID to the same value in Vercel.
# BURN_TOKEN_ID=3
BURN_SITE_URL=https://your-burn-site.vercel.app
REVEAL_SITE_URL=https://your-reveal-site.vercel.app
# Optional: custom SQLite path (Railway volume mount)
# DB_PATH=/data/burns.db
# Number of FCFS slots already committed before this deployment. Defaults to 2,
# leaving 8 of the 10 total slots available. Set to 0 for a new event.
# INITIAL_POOL_COUNT=2

# ── Manifold auto-mint ──────────────────────────────────────────────────────
# BURN2_MANIFOLD_CONTRACT=0xYourBurn2ManifoldContract
# BURN2_MANIFOLD_TOKEN_ID=1
# BURN1_MANIFOLD_CONTRACT=0xYourBurn1ManifoldContract
# BURN1_MANIFOLD_TOKEN_ID=1
# Optional: pool defaults to Burn ×1 when these are omitted.
# POOL_MANIFOLD_CONTRACT=0xYourPoolManifoldContract
# POOL_MANIFOLD_TOKEN_ID=1
# MANIFOLD_CONTRACT_CHAIN=base        # 'base' or 'mainnet'
# MINTER_PRIVATE_KEY=0xYourMinterWalletPrivateKey
# MANIFOLD_RPC_URL=                   # optional, leave blank to use default

# ── NFT slideshow (paste OpenSea links in admin panel) ───────────────────────
# OPENSEA_API_KEY=                    # get one free at docs.opensea.io — without it requests are heavily rate-limited
